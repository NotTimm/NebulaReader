[Desktop Entry]
Name=Nebula
GenericName=Book & Comic Reader
Comment=Read comics, manga and EPUB books from your library
Exec=nebula-reader %f
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=io.github.NotTimm.NebulaReader
MimeType=application/x-cbz;application/vnd.comicbook+zip;application/x-cbr;application/vnd.comicbook-rar;application/epub+zip;
Icon=io.github.NotTimm.NebulaReader
Categories=Graphics;Viewer;X-COSMIC;
Keywords=Nebula;Jellyfin;Comic;Comics;Manga;CBZ;CBR;EPUB;Ebook;Book;Reader;Library;ComicVine;AniList;
