[Desktop Entry]
Name=Cosmic Comic
GenericName=Comic Book Reader
Comment=Read comics, manga and EPUB books from your library
Exec=cosmic-comic %f
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=com.tsingel.CosmicComic
MimeType=application/x-cbz;application/vnd.comicbook+zip;application/x-cbr;application/vnd.comicbook-rar;application/epub+zip;
Icon=com.tsingel.CosmicComic
Categories=Graphics;Viewer;X-COSMIC;
Keywords=Comic;Comics;Manga;CBZ;CBR;EPUB;Ebook;Book;Reader;Library;ComicVine;AniList;
